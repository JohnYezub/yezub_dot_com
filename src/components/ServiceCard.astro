---
import type { ServiceCard } from '../i18n/types';

interface Props {
  card: ServiceCard;
}

const { card } = Astro.props;
const dots = [0, 1, 2].map((i) => i < card.dots);
---

<details
  data-svc
  data-reveal
  style="background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 22px; opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1);"
  style-hover="border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);"
>
  <summary>
    <div style="display: flex; align-items: flex-start; gap: 14px;">
      <span style="font-family: var(--font-heading); font-size: 13px; color: var(--color-accent); padding-top: 4px;">{card.n}</span>
      <div style="flex: 1;">
        <div style="font-family: var(--font-heading); font-size: 19px; letter-spacing: -.02em;">{card.title}</div>
        <div style="font-size: 13px; color: var(--color-accent-300); margin-top: 6px;">{card.price}</div>
      </div>
      <span style="display: flex; gap: 4px; padding-top: 8px;">
        {
          dots.map((on) => (
            <span
              style={`width: 5px; height: 5px; border-radius: 50%; background: ${on ? 'var(--color-accent)' : 'var(--color-neutral-800)'};`}
            />
          ))
        }
      </span>
    </div>
  </summary>
  <div
    style="margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--color-divider); font-size: 14px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 78%, transparent);"
  >
    <p style="margin: 0 0 12px;">{card.intro}</p>
    <ul style={`margin: 0${card.note ? ' 0 12px' : ''}; padding-left: 18px; display: grid; gap: 6px;`}>
      {card.list.map((li) => <li set:html={li} />)}
    </ul>
    {
      card.note && (
        <p style="margin: 0; font-style: italic; font-size: 13px; color: color-mix(in srgb, var(--color-text) 55%, transparent);">
          {card.note}
        </p>
      )
    }
  </div>
</details>
