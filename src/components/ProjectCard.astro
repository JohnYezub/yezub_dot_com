---
import type { Project } from '../i18n/types';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;

const bg = p.featured
  ? 'linear-gradient(160deg, color-mix(in srgb, var(--color-accent) 14%, var(--color-surface)), var(--color-surface) 60%)'
  : 'var(--color-surface)';
const cardStyle = `${p.featured ? 'grid-column: span 1; ' : ''}background: ${bg}; border: 1px solid var(--color-divider); border-radius: var(--radius-lg); padding: 26px; opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1);`;

const tagsBottom = p.list || p.link ? 16 : 0;
const listBottom = p.link ? 18 : 0;
const tagClass = (v: string) => `tag tag-${v}`;
---

<article data-reveal style={cardStyle} style-hover="border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);">
  <div style="font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 10px;">{p.kicker}</div>
  <h3 style={`font-size: ${p.titleSize}px; letter-spacing: -.025em; margin: 0 0 10px;`} set:html={p.title} />
  <p style="margin: 0 0 16px; font-size: 14px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 76%, transparent);" set:html={p.desc} />

  {
    p.tags && (
      <div style={`display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: ${tagsBottom}px;`}>
        {p.tags.map((tag) => <span class={tagClass(tag.variant)}>{tag.label}</span>)}
      </div>
    )
  }

  {
    p.list && (
      <ul style={`margin: 0 0 ${listBottom}px; padding-left: 18px; font-size: 13.5px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 72%, transparent); display: grid; gap: 6px;`}>
        {p.list.map((li) => (
          <li>{li}</li>
        ))}
      </ul>
    )
  }

  {
    p.link && p.meta && (
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 16px; border-top: 1px solid var(--color-divider);">
        <span style={`font-size: 12px; ${p.metaItalic ? 'font-style: italic; ' : ''}color: color-mix(in srgb, var(--color-text) 52%, transparent);`}>{p.meta}</span>
        <a href={p.link.href} target="_blank" rel="noopener" class="btn btn-secondary">{p.link.label}</a>
      </div>
    )
  }
  {
    p.link && !p.meta && (
      <div style="padding-top: 16px; border-top: 1px solid var(--color-divider);">
        <a href={p.link.href} target="_blank" rel="noopener" class="btn btn-secondary">{p.link.label}</a>
      </div>
    )
  }
</article>
