---
import Base from '../../layouts/Base.astro';
import BlogShell from '../../components/BlogShell.astro';
import { itemListNode, breadcrumbNode } from '../../lib/seo';
import { backendEntries } from '../../blog/backend';
import { adtechEntries } from '../../blog/adtech';
import { growthChapters } from '../../blog/growth';

const meta = {
  title: 'Блог — Евгений Езуб',
  description: 'Короткие базы знаний со схемами и текстами: как устроено и какими решениями какие задачи решать.',
};

const schema = [
  breadcrumbNode([{ name: 'Блог', path: '/blog' }]),
  itemListNode([
    { name: 'Запуск и рост приложения', path: '/blog/growth' },
    { name: 'Backend Map 2026', path: '/blog/backend' },
    { name: 'AdTech с нуля', path: '/blog/adtech' },
  ]),
];
---

<Base lang="ru" page="blog" meta={meta} path="/blog" schema={schema}>
  <BlogShell>
    <header style="padding: 56px 0 32px;">
      <div class="kicker">Блог</div>
      <h1>Базы знаний</h1>
      <p class="lead">Короткие шпаргалки со схемами: что где устроено, какими решениями какие задачи решать и что для чего нужно.</p>
    </header>
    <ul class="toc" style="padding-bottom: 72px;">
      <li>
        <a class="card" href="/blog/growth">
          <span class="n">01</span>
          <span class="t">Запуск и рост приложения</span>
          <span class="d">Руководство: аудитория, аналитика, атрибуция, ASO, реклама, монетизация, юнит-экономика и план на 90 дней. {growthChapters.length} глав со схемами.</span>
        </a>
      </li>
      <li>
        <a class="card" href="/blog/backend">
          <span class="n">02</span>
          <span class="t">Backend</span>
          <span class="d">Карта backend-разработки 2026: от осей компромиссов до system design. {backendEntries.length} страниц — схема и тезисы.</span>
        </a>
      </li>
      <li>
        <a class="card" href="/blog/adtech">
          <span class="n">03</span>
          <span class="t">AdTech</span>
          <span class="d">Programmatic advertising с нуля: участники, RTB, mediation, eCPM, данные и yield optimization. {adtechEntries.length} страниц — схема и тезисы.</span>
        </a>
      </li>
    </ul>
  </BlogShell>
</Base>
