---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../../layouts/Base.astro';
import BlogShell from '../../../components/BlogShell.astro';
import { growthChapters, shortLead } from '../../../blog/growth';
import { growthCards } from '../../../blog/growth-cards';

export function getStaticPaths() {
  return growthChapters.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, index: i },
  }));
}

const { entry, index } = Astro.props;
const { Content } = entry;
const card = growthCards[entry.n];
const lead = card?.lead ?? entry.lead;
const images = import.meta.glob<{ default: ImageMetadata }>('../../../assets/blog/growth/*.webp', { eager: true });
const image = entry.image ? images[`../../../assets/blog/growth/${entry.image}.webp`].default : undefined;

const prev = growthChapters[index - 1];
const next = growthChapters[index + 1];
const pad = (n: number) => String(n).padStart(2, '0');

const meta = {
  title: `${entry.title} — Запуск и рост приложения — Евгений Езуб`,
  description: shortLead(lead, 200),
};
---

<Base lang="ru" page="blog" meta={meta} path={`/blog/growth/${entry.slug}`}>
  <BlogShell>
    <nav class="crumbs" aria-label="Навигация">
      <a href="/blog">Блог</a><span>/</span><a href="/blog/growth">Запуск и рост</a><span>/</span><span>{pad(entry.n)}</span>
    </nav>
    <header style="padding: 28px 0 0;">
      <div class="kicker">Глава {pad(entry.n)} / {growthChapters.length}</div>
      <h1>{entry.title}</h1>
      <p class="lead">{lead}</p>
    </header>

    {
      image && (
        <>
          <a class="figure" href={image.src} target="_blank" rel="noopener" aria-label="Открыть схему в полном размере">
            <Image src={image} alt={entry.caption ?? entry.title} widths={[640, 960, 1536]} sizes="(max-width: 1236px) 100vw, 1180px" loading="eager" />
          </a>
          <div class="figcap muted">{entry.caption}</div>
        </>
      )
    }

    {
      card && (
        <div class="grid2" style={image ? undefined : 'margin-top: 36px;'}>
          <section class="panel">
            <h2>Главное</h2>
            <ul>{card.points.map((p) => <li set:html={p} />)}</ul>
          </section>
          <div class="stack">
            {card.example && (
              <section class="panel">
                <h2>{card.example.title}</h2>
                <pre><code>{card.example.code}</code></pre>
              </section>
            )}
            {card.pick && (
              <section class="panel">
                <h2>{card.pick.title ?? 'Что когда выбирать'}</h2>
                <ul>{card.pick.items.map((p) => <li set:html={p} />)}</ul>
              </section>
            )}
            {card.warn && (
              <section class="panel warn">
                <h2>{card.warn.title}</h2>
                <p set:html={card.warn.text} />
              </section>
            )}
          </div>
        </div>
      )
    }

    <article class="prose" style={card ? 'margin-top: 56px;' : undefined}>
      {card && <div class="kicker" style="margin-bottom: 8px;">Подробный разбор</div>}
      <Content />
    </article>

    <nav class="pager" aria-label="Соседние главы">
      {
        prev ? (
          <a class="card" href={`/blog/growth/${prev.slug}`}><small>← {pad(prev.n)}</small><span>{prev.title}</span></a>
        ) : (
          <a class="card" href="/blog/growth"><small>←</small><span>Оглавление</span></a>
        )
      }
      {
        next ? (
          <a class="card next" href={`/blog/growth/${next.slug}`}><small>{pad(next.n)} →</small><span>{next.title}</span></a>
        ) : (
          <a class="card next" href="/blog/growth"><small>Конец →</small><span>Оглавление</span></a>
        )
      }
    </nav>
  </BlogShell>
</Base>
